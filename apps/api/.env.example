# Project Service executado diretamente na máquina.
PORT=3333
CORS_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://labgraph:labgraph@localhost:5436/labgraph_projects?schema=public

# Kafka exposto pelo Compose para a máquina host.
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=project-service-local
KAFKA_IDENTITY_GROUP_ID=project-service-identity-v1
