# Identity Service executado diretamente na máquina.
PORT=3334
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
# Prefixo visto pelo navegador. Vazio em localhost; use /api com o proxy Vercel.
AUTH_PUBLIC_PATH_PREFIX=
IDENTITY_DATABASE_URL=postgresql://labgraph:labgraph@localhost:5433/labgraph_identity?schema=public

# Gere com randomBytes(64). Nunca versione o valor real.
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRATION=900

# Preencha quando iniciar a implementação do login Google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Kafka exposto pelo Compose para a máquina host.
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=identity-service-local
