# Identity Service executado diretamente na máquina.
PORT=3334
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
IDENTITY_DATABASE_URL=postgresql://labgraph:labgraph@localhost:5433/labgraph_identity?schema=public

# Gere valores diferentes com randomBytes(64). Nunca versione os valores reais.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Preencha quando iniciar a implementação do login Google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
