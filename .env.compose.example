# Variáveis lidas pelo Docker Compose local.
CORS_ORIGIN=http://localhost:5173

# O login Google pode ficar vazio até a implementação do OAuth.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Somente desenvolvimento local. Gere valores próprios no Railway.
JWT_ACCESS_SECRET=change-me-local-access
JWT_ACCESS_EXPIRATION=900
